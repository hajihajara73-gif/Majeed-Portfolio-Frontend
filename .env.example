# Public site build configuration. Copy to `.env.local` and fill in.
#
# Everything here is BAKED INTO THE BUNDLE at build time and is therefore
# public. Never put a secret, a database URL or an API key in this file.
#
# These are read at BUILD time, not at runtime. On Vercel they must be set
# before the build you intend to keep — a build made without them produces an
# admin that cannot reach the API and a site with no canonical link or sitemap.

# --- the deployed API --------------------------------------------------------
# Live backend (Render):  https://majeed-portfolio-backend.onrender.com
# Once DNS is set up this becomes https://api.<your-domain>, which is the one to
# use — see the note under VITE_API_BASE_URL.

# Where the contact form posts. The only runtime request the public site makes.
# Leave it unset and the form says sending is not connected rather than
# pretending to deliver.
#   dev:        http://localhost:8000/api/public/contact
#   production: https://majeed-portfolio-backend.onrender.com/api/public/contact
VITE_CONTACT_ENDPOINT=http://localhost:8000/api/public/contact

# Origin of the API, used by the ADMIN at /admin/.
#
# Leave it UNSET in local development: requests then stay relative and Vite's
# dev proxy forwards them to localhost:8000, which keeps everything same-origin.
#
# It must be set for production, or the admin issues relative /api/... requests
# that resolve against Vercel and 404.
#
# IMPORTANT — pick the host carefully. The admin session cookie is SameSite=Lax,
# which a browser sends only when the two are on the same registrable domain:
#
#   site on example.me  ->  api.example.me       same site, works
#   site on *.vercel.app -> *.onrender.com       DIFFERENT sites, cookie is
#                                                withheld: login appears to
#                                                succeed and every request after
#                                                it is 401
#
# So use https://api.<your-domain> once DNS is live. Using the raw onrender.com
# host for the admin additionally requires SESSION_COOKIE_SAMESITE=none on the
# backend, which is a real weakening and which browsers increasingly block.
#   production: https://api.your-domain.example
VITE_API_BASE_URL=

# The site's own public origin, e.g. https://your-domain.example
#
# Feeds the canonical link, og:url, the absolute og:image, robots.txt and
# sitemap.xml. Leave it unset and all of those are omitted rather than emitted
# pointing at the wrong domain — a sitemap for somebody else's host is worse
# than no sitemap. Set it before launch.
VITE_SITE_URL=
